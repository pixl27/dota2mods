// The installer's resources. The icon is Wardrobe's own; the description is
// what the Windows SmartScreen and properties dialogs show.
#include <winver.h>
1 ICON "../../assets/wardrobe.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 6,0,0,0
PRODUCTVERSION 6,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "FileDescription", "Installation de Wardrobe"
            VALUE "ProductName", "Wardrobe"
            VALUE "FileVersion", "6.0"
            VALUE "ProductVersion", "6.0"
            VALUE "OriginalFilename", "Wardrobe-Setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
